{{ ansible_managed | comment }}

[Service]
ExecStart=
ExecStart=/usr/sbin/haveged{% if haveged_write_wakeup_threshold_stat.stat.exists and ansible_connection not in ['container', 'docker', 'community.docker.docker'] %} --write {{ haveged_write_wakeup_threshold }}{% endif %} --verbose 1 --Foreground
# haveged is killed (SIGTRAP) on some CPUs when MemoryDenyWriteExecute is enabled (Debian 13 unit).
MemoryDenyWriteExecute=false
{% if ansible_connection in ['container', 'docker', 'community.docker.docker'] %}
# Inside a container the sandboxing of the stock unit makes haveged exit (seen on GitHub runners), drop it there.
PrivateDevices=false
PrivateNetwork=false
ProtectSystem=false
ProtectKernelLogs=false
ProtectKernelModules=false
RestrictNamespaces=false
RestrictRealtime=false
LockPersonality=false
SecureBits=
CapabilityBoundingSet=
SystemCallFilter=
SystemCallArchitectures=
{% endif %}

# Debian 13 does not start haveged in containers, reset that condition (it makes no difference on real systems).
[Unit]
ConditionVirtualization=
